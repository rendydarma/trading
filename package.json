{
  "name": "trading-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing Tokocrypto and Binance market data and trading tools (via ccxt).",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "trading-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.js",
    "test:tokocrypto": "node scripts/test-tokocrypto.js",
    "indicators": "node scripts/indicators.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:indicators": "node scripts/indicators.js --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ccxt": "^4.4.90",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=21"
  }
}
