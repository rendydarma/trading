# Binance credentials (create at https://www.binance.com/en/my/settings/api-management)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional: use Binance Spot Testnet (requires testnet keys)
BINANCE_SANDBOX=false
# Optional: "spot" (default), "future", "margin", "delivery"
BINANCE_DEFAULT_TYPE=spot

# Tokocrypto credentials (API is enabled from the Tokocrypto website)
# Legacy misspelled TOKOCYPTO_* names are still read as a fallback.
TOKOCRYPTO_API_KEY=
TOKOCRYPTO_API_SECRET=
TOKOCRYPTO_SANDBOX=false

# Order safety: orders are only sent when TRADING_LIVE=true
TRADING_LIVE=false
# REQUIRED for live orders: reject orders above this notional value, expressed in the MAX_ORDER_QUOTE currency
MAX_ORDER_NOTIONAL=
# REQUIRED for live orders: quote currency MAX_ORDER_NOTIONAL is expressed in (e.g. USDT); orders on markets with another quote are blocked
MAX_ORDER_QUOTE=
# Optional: comma-separated allowlist, e.g. BTC/USDT,ETH/USDT
ALLOWED_SYMBOLS=
